^geoscales\.Rproj$
^\.Rproj\.user$
^\.github$
^\.git$
^cpp$
^python$
^docs$
^specs$
^benchmark$
# Phase-2 C++ header tree; empty until then, so keep it out of the build.
# Note: must NOT be `^inst$` -- that would also drop the `inst/doc` directory
# that vignette building creates, and installing vignettes would fail.
^inst/include$
# pkgdown-only articles, not vignettes. `articles/plotting.Rmd` draws on the
# UTOPIA map from `energyRt`; keeping it out of the build is what lets
# `energyRt` stay out of Suggests (it is in `Config/Needs/website` instead).
^vignettes/articles$
# Apache-2.0 is a standard R license abbreviation, so the text is not shipped.
^LICENSE$
^geoscales\.Rcheck$
^.*\.tar\.gz$
^dev$
^drafts$
^tmp$
^NOTICE$
^CONTRIBUTING\.md$
^CITATION\.cff$
^VERSION$
^README\.Rmd$
^_pkgdown\.yml$
^pkgdown$
^doc$
^Meta$
^\.lintr$
^\.vscode$
^\.editorconfig$
^\.claude$
# generation scripts and raw Global Wind Atlas downloads -- data-raw/gwa
# is additionally gitignored, ~64 MB of GeoTIFF
^data-raw$
^AGENTS\.md$
^CLAUDE\.md$
