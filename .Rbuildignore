^geoscales\.Rproj$
^\.Rproj\.user$
^\.github$
^\.git$
^cpp$
^python$
^docs$
^specs$
^benchmark$
# C++ header tree, not part of the R package. Must not be `^inst$`: that
# would also drop the `inst/doc` directory that vignette building creates.
^inst/include$
# Site-only articles, not vignettes. The packages they need are listed in
# `Config/Needs/website`, not in Suggests.
^vignettes/articles$
# Apache-2.0 is a standard R license abbreviation, so the text is not shipped.
^LICENSE$
^geoscales\.Rcheck$
^.*\.tar\.gz$
^dev$
^drafts$
^tmp$
^NOTICE$
^CONTRIBUTING\.md$
^CITATION\.cff$
^VERSION$
^README\.Rmd$
^README\.html$
^_pkgdown\.yml$
^pkgdown$
^doc$
^Meta$
^\.lintr$
^\.vscode$
^\.claude$
# generation scripts and raw downloads (the downloads are also gitignored)
^data-raw$
^AGENTS\.md$
^tools$
^cran-comments\.md$
^CRAN-SUBMISSION$
